UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SESSION_SECRET=change-me-to-a-long-random-string

# Unlocks /admin.html. Leave empty to disable the admin panel entirely.
# Minimum 8 characters; this is separate from any player account.
ADMIN_PASSWORD=

# If Redis vars are empty, local `vercel dev` stores data in .data/store.json
# Hosted Vercel deploys require the Upstash variables.
